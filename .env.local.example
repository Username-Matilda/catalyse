# Local overrides — copy this to .env.local and fill in values.
# .env.local is gitignored and should never be committed.

# Postgres connection URL. Required. The default matches docker-compose.yml
# (`docker compose up -d`). Running `npx prisma dev` instead? Use the URL it prints and
# append `&pgbouncer=true&connection_limit=1` — it serves a single session.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalyse

# Your email address — grants admin access on login. Required for local development.
ADMIN_EMAILS=you@example.com

# Google OAuth client ID — enables the "Sign in with Google" button.
# Get the value from production, then add http://localhost:3000 as an
# authorised JavaScript origin in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Resend API key — required to send real emails (password reset, welcome, etc.).
# Leave unset (and set STUB_EMAIL=true in .env) to log emails to the console instead.
RESEND_API_KEY=

# Read-only key for the anonymised-copy bucket, used by `npm run fetch-prod-db`. Put these
# in .env.b2 (gitignored) or here; see README "Backups and the anonymised copy".
# B2_ANON_KEY_ID=
# B2_ANON_APP_KEY=
# B2_ANON_BUCKET_NAME=catalyse-anonymised

# Production-only: full-access key for the raw backup bucket. Never set outside production.
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET_NAME=

# Railway-only: path where the persistent volume is mounted; the last week of pg_dump
# backups is kept there. Leave unset for local development.
# RAILWAY_VOLUME_MOUNT_PATH=/data

# Railway-only: secret token for cron endpoints. Set in Railway and pass as
# Authorization: Bearer <value> when triggering /api/cron/* routes.
# Leave unset for local development.
# CRON_SECRET=

# Production app URL — used by npm run cron:* scripts to trigger prod endpoints.
# PROD_URL=https://catalyse.up.railway.app

# Google Analytics measurement ID — e.g. G-XXXXXXXXXX.
# Leave unset to disable analytics entirely (no banner will appear).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
